# Checked-in non-secret runtime configuration for local and sandbox development.

# === Environment identity ===
TRIPPLANNER_ENVIRONMENT=local
OPS_DASHBOARD_OWNER_EMAIL=munishgoyal1@gmail.com
# === End: Environment identity ===

# === Azure OpenAI ===
ENABLE_AZURE_OPENAI=1
AZURE_OPENAI_ENDPOINT=https://aoaiprodtp9fe3951c.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_MODEL_VERSION=2026-03-17
AZURE_OPENAI_API_VERSION=2024-10-21
# === End: Azure OpenAI ===

# === Travel provider APIs (hotels, flights, activities, trains, coaches, ferries) ===
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
TRAVEL_HOTEL_PROVIDER=auto
TRAVEL_FLIGHT_PROVIDER=auto
VIATOR_BASE_URL=https://api.sandbox.viator.com/partner
TRAVEL_ACTIVITY_PROVIDER=auto
ENABLE_AMADEUS_LEGACY=0
AMADEUS_BASE_URL=https://test.api.amadeus.com
FLIGHT_DURATION_DEFAULT_MIN=90
AIRPORT_DEPARTURE_BUFFER_MIN=120
AIRPORT_ARRIVAL_BUFFER_MIN=45
RAILWAY_DEPARTURE_BUFFER_MIN=45
RAILWAY_ARRIVAL_BUFFER_MIN=15
BUS_DEPARTURE_BUFFER_MIN=30
BUS_ARRIVAL_BUFFER_MIN=15
ENABLE_TRAIN_PRICING=0
ENABLE_COACH_PRICING=0
ENABLE_FERRY_PRICING=0
TRAVEL_TRAIN_PROVIDER=auto
TRAVEL_COACH_PROVIDER=auto
TRAVEL_FERRY_PROVIDER=auto
KIWI_BASE_URL=https://www.kiwi.com/api/v1
OMIO_BASE_URL=https://api.omio.com
# === End: Travel provider APIs ===

# === Alternate routing provider (OpenRouteService, non-Google fallback) ===
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_ROUTE_TTL_SEC=21600
# === End: Alternate routing provider ===

# === Provider response cache (TTLs + Redis) ===
CACHE_TTL_SCALE=1
CACHE_STABLE_FOREVER=1
CACHE_VOLATILE_FOREVER=1
CACHE_WARM_EVERYTHING=1
HOTEL_SEARCH_CACHE_TTL_SEC=600
FLIGHT_SEARCH_CACHE_TTL_SEC=600
ACTIVITY_SEARCH_CACHE_TTL_SEC=21600
FLIGHT_CACHE_TTL_SEC=14400
HOTEL_CACHE_TTL_SEC=14400
TRAIN_CACHE_TTL_SEC=43200
COACH_CACHE_TTL_SEC=43200
FERRY_CACHE_TTL_SEC=43200
ACTIVITY_CACHE_TTL_SEC=86400
CACHE_REDIS_ENABLED=0
CACHE_REDIS_NAMESPACE=tripplanner:local:provider-cache
CACHE_REDIS_CONNECT_TIMEOUT_SEC=5
CACHE_REDIS_SOCKET_TIMEOUT_SEC=5
# === End: Provider response cache ===

# === Road cost estimation ===
ROAD_FUEL_PRICE_PER_LITRE=
ROAD_FUEL_LITRES_PER_100KM=
ROAD_COST_CURRENCY=
# === End: Road cost estimation ===

# === Google Cloud (Places, Maps, Analytics, OAuth) ===
ENABLE_GOOGLE_PLACES=1
ENABLE_GOOGLE_MAPS=1
GOOGLE_PLACES_METADATA_CACHE_TTL_SEC=604800
GOOGLE_PLACES_SEARCH_CACHE_TTL_SEC=604800
GOOGLE_PLACES_REVIEWS_CACHE_TTL_SEC=604800
GOOGLE_PLACES_MISS_CACHE_TTL_SEC=60
GOOGLE_PLACES_HOURS_CACHE_TTL_SEC=7200
GOOGLE_PLACES_PHOTO_URL_CACHE_TTL_SEC=3000
GOOGLE_ANALYTICS_MEASUREMENT_ID=
OAUTH_GOOGLE_CLIENT_ID=462807288215-0o94u9c6vqvuj9r95j87m66paiar8nfb.apps.googleusercontent.com
OAUTH_REDIRECT_BASE=http://localhost:5173/api
# === End: Google Cloud ===

# === Request throttling & usage limits ===
# Single place for every throttle/budget is src/tripplanner/limits_config.py
# (see its docstring). The sub-blocks below mirror its sections exactly.

# --- Per-trip Google Places call budgets ---
# Bounded counters scoped to one trip; breaching one doesn't reject the
# request, the agent just stops calling that tool and reuses prior results.
GOOGLE_PLACES_MAX_TEXT_SEARCHES_PER_TRIP=3
GOOGLE_PLACES_MAX_REVIEW_DETAILS_PER_TRIP=1
GOOGLE_PLACES_MAX_PHOTOS_PER_TRIP=3
GOOGLE_PLACES_MAX_PHOTOS_PER_PLACE=1
# --- End: Per-trip Google Places call budgets ---

# --- Agent tool-call budgets ---
# The other per-turn/per-trip lever (with the Places counters above) that
# caps paid-provider spend. See docs/operations/gcp-billing-guardrails.md.
MAX_TOOL_PHASES_PER_TURN=50
MAX_INITIAL_ITINERARY_UPDATES=5
MAX_POST_RESEARCH_UPDATES=1
MAX_TRANSPORT_COMPARISONS_PER_TURN=10
MAX_TRANSPORT_COMPARISONS_PER_TRIP=10
# --- End: Agent tool-call budgets ---

# --- Time-window throttling ---
# Sliding per-minute + concurrency admission for /chat. This is the
# anti-abuse / anti-viral-spike lever: bounds requests served per time
# window, independent of what any one request does. Breach -> HTTP 429.
CHAT_USER_REQUESTS_PER_MINUTE=10
CHAT_IP_REQUESTS_PER_MINUTE=30
CHAT_REPLAY_LOOKUPS_PER_MINUTE=60
CHAT_REPLAY_LOOKUPS_PER_IP_PER_MINUTE=180
CHAT_MAX_CONCURRENT_PER_USER=1
CHAT_MAX_CONCURRENT_GLOBAL=4
# --- End: Time-window throttling ---

# --- Durable daily/weekly/lifetime conversation ceilings ---
# Survive restarts (Cosmos/local-file backed). Breach -> HTTP 429 with a
# resets_at time; saved trips/preferences are unaffected.
CHAT_NEW_TRIP_LIMIT_DAILY=10
CHAT_EXISTING_TRIP_TURN_LIMIT_DAILY=20
CHAT_NEW_TRIP_LIMIT_WEEKLY=25
CHAT_EXISTING_TRIP_TURN_LIMIT_WEEKLY=50
CHAT_NEW_TRIP_LIMIT_LIFETIME=50
CHAT_EXISTING_TRIP_TURN_LIMIT_LIFETIME=100
# --- End: Durable daily/weekly/lifetime conversation ceilings ---

# --- Monthly LLM cost cap ---
# Per-user running $ total; <= 0 disables it. Breach -> soft in-chat refusal
# (HTTP 200), not a 429.
MONTHLY_LLM_COST_CAP_USD=20
# --- End: Monthly LLM cost cap ---

# === End: Request throttling & usage limits ===

# === Storage (Cosmos DB + secondary durable cache) ===
COSMOS_DEV_BACKEND=emulator
COSMOS_ENDPOINT=https://localcosmos2cgsfp.documents.azure.com:443/
COSMOS_DATABASE=tripplanner
COSMOS_USE_MANAGED_IDENTITY=0
COSMOS_EMULATOR=0
SECONDARY_DURABLE_CACHE_ENABLED=1
SECONDARY_DURABLE_CACHE_ENDPOINT=https://localhost:8081
SECONDARY_DURABLE_CACHE_DATABASE=tripplanner-cache
SECONDARY_DURABLE_CACHE_USE_MANAGED_IDENTITY=0
SECONDARY_DURABLE_CACHE_EMULATOR=1
# === End: Storage ===

# === Logging, audit & app behavior ===
LOG_LEVEL=INFO
LOG_JSON=0
AUDIT_USER_MESSAGES=0
DECISIONS_UI_ENABLED=1
WEB_ALLOWED_ORIGINS=*
TRIPPLANNER_DEBUG_STORE=1
# === End: Logging, audit & app behavior ===

# === Email / communications ===
AZURE_COMMUNICATION_EMAIL_SENDER=donotreply@b9a32f35-8b44-4272-9257-8f4b8ae6000a.azurecomm.net
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_USE_TLS=1
# === End: Email / communications ===
