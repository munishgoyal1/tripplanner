# === Request throttling & usage limits ===
# Single place for every limit is src/tripplanner/limits_config.py (see its
# docstring). There is exactly ONE cost control -- the INR ceiling below.
# Everything else here bounds request RATE, not spend.
#
# Deliberately absent: per-trip Google Places call budgets and per-turn agent
# tool-call budgets. Those counted calls as a proxy for money and throttled
# quality on legitimately complex trips. The agent may now make whatever calls
# a good itinerary needs; cost_ledger.py measures what that actually costs and
# the ceiling below stops the environment when the money runs out. Loop
# breakers that merely stop non-terminating flows live in code
# (graph_policy.MAX_TOOL_PHASES_PER_TURN and friends), not here.

# --- Spend ceiling (the uber control) ---
# Environment-wide measured spend across Azure OpenAI + Google Cloud together,
# in INDIAN RUPEES. Breach -> HTTP 429 carrying resets_at; saved trips and
# preferences are unaffected.
#
# UNITS: INR, never USD. Provider catalogs quote USD and convert exactly once,
# in cost_model.usd_to_inr. Pasting a USD figure here would raise the real
# ceiling by ~88x.
#
# The three windows are NOT multiples of each other on purpose: daily is a
# burst allowance, monthly is the real constraint. At the ~INR 42 average trip
# this model predicts, INR 10,000/month is roughly 13 full testing days, so a
# run of INR 1,000 days exhausts the month well before day 30.
COST_CEILING_INR_DAILY=1000
COST_CEILING_INR_WEEKLY=5000
COST_CEILING_INR_MONTHLY=10000
# Set to 0 to observe and report spend without ever refusing a turn.
COST_CEILING_ENFORCED=1
# Admission decision when the ledger itself cannot be read: an unreadable
# ledger means unknown spend, so hosted environments deny.
COST_CEILING_DENY_ON_LEDGER_ERROR=0
# --- End: Spend ceiling ---

# --- Anti-abuse admission ---
# Sliding per-minute + concurrency admission for /chat. Bounds how fast
# requests arrive, NOT how much they cost -- the ceiling above owns spend.
# Sized so genuine owner testing and a genuine production user never reach
# them; they exist for scripted abuse and viral spikes. Breach -> HTTP 429.
CHAT_USER_REQUESTS_PER_MINUTE=30
CHAT_IP_REQUESTS_PER_MINUTE=90
CHAT_MAX_CONCURRENT_PER_USER=5
CHAT_MAX_CONCURRENT_GLOBAL=12
# --- End: Anti-abuse admission ---

# --- Presentation ---
# How large a photo gallery one page render builds. Visual-density choices,
# not cost controls. PER_REQUEST is named for what it scopes: its predecessor
# said PER_TRIP but reset on every HTTP request, so a trip viewed five times
# signed five times the documented number of photo URLs.
GOOGLE_PLACES_MAX_PHOTOS_PER_PLACE=1
GOOGLE_PLACES_MAX_PHOTOS_PER_REQUEST=40
# --- End: Presentation ---

# === End: Request throttling & usage limits ===

# === Storage (Cosmos DB + secondary durable cache) ===
COSMOS_DEV_BACKEND=emulator
COSMOS_ENDPOINT=https://localcosmos2cgsfp.documents.azure.com:443/
COSMOS_DATABASE=tripplanner
COSMOS_USE_MANAGED_IDENTITY=0
COSMOS_EMULATOR=0
SECONDARY_DURABLE_CACHE_ENABLED=1
SECONDARY_DURABLE_CACHE_ENDPOINT=https://localhost:8081
SECONDARY_DURABLE_CACHE_DATABASE=tripplanner-cache
SECONDARY_DURABLE_CACHE_USE_MANAGED_IDENTITY=0
SECONDARY_DURABLE_CACHE_EMULATOR=1
# === End: Storage ===

# === Logging, audit & app behavior ===
# Master recorder flag (private diagnostics + local trip archive). Restart to apply.
TRIPPLANNER_FLIGHT_RECORDER=0
LOG_LEVEL=INFO
LOG_JSON=0
AUDIT_USER_MESSAGES=0
# Writes the full, untruncated prompt sent to the LLM (all messages, secret
# strings stripped) into the normal log stream, tagged with turn_number and
# phase_number -- for understanding the agent's tool-calling flow during
# local dev. Gated in code to environment == "local" regardless of this
# flag, so it can never fire in canary/prod even if set there by mistake.
LOG_FULL_LLM_PROMPTS=1
DECISIONS_UI_ENABLED=1
WEB_ALLOWED_ORIGINS=*
TRIPPLANNER_DEBUG_STORE=1
# === End: Logging, audit & app behavior ===

# === Local validation gates ===
# Which checks the lane scripts run before they land work: sandbox.ps1
# (-Merge/-Promote), full-2way-sync.ps1 (branch-lane publish), and
# multiagent.py (coordinator integration). One value per gate, read by
# scripts/dev/lib/validation-policy.ps1 and scripts/dev/validation_policy.py.
#
# required  = run it
# suspended = skip it, and say loudly that it was skipped
#
# Nothing is deleted when a gate is suspended: the command still sits at its
# call site behind a gate check, so turning one back on is one word here.
# A value that is neither word, or a missing file, fails CLOSED -- the gate
# runs. A policy that cannot be read must never be why a check stops running.
#
# Per-run overrides, without editing this file:
#   sandbox.ps1 -Merge <lane> -FullSuites     every gate, one invocation
#   $env:TRIPPLANNER_FULL_SUITES = "1"        every gate, one shell/session
#   $env:VALIDATION_GATE_PYTEST = "required"  one gate, one shell/session
# A real environment variable always beats the value set here.

# ~2s. The narrow E9,F63,F7,F82 selection CI uses, not the project's full ruff
# config: that reports ~145 findings on master (mostly E501) and would be red
# from the first run.
VALIDATION_GATE_LINT=required

# Suspended 2026-09-12. `npm run typecheck` (tsc -b) measured 143.9s here, and
# CI runs it on every pull request and every push to master on a dedicated
# runner. Paying again on a loaded dev machine buys delay, not information.
VALIDATION_GATE_TYPECHECK=suspended

# Suspended 2026-09-12. `npm run build` measured 230s cold and 500s under
# concurrent load. Also covered by CI on every PR and every master push.
VALIDATION_GATE_BUILD=suspended

# Suspended 2026-09-12. 2082 tests, 20m22s at -n 2, on every merge, promote and
# branch-lane publish -- and the last such run still failed on seven of them.
# Paid once on master instead: pwsh scripts/dev/suite-health.ps1
# Known debt: scripts/dev/test-health-baseline.json
VALIDATION_GATE_PYTEST=suspended

# Suspended 2026-09-12. Ran alongside pytest at every gate; jsdom setup costs
# tens of seconds per file. Same replacement as pytest above.
VALIDATION_GATE_VITEST=suspended
# === End: Local validation gates ===

