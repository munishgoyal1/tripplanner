# === End: Google Cloud ===

# === Request throttling & usage limits ===
# Single place for every limit is src/tripplanner/limits_config.py (see its
# docstring). There is exactly ONE cost control -- the INR ceiling below.
# Everything else here bounds request RATE, not spend.
#
# Deliberately absent: per-trip Google Places call budgets and per-turn agent
# tool-call budgets. Those counted calls as a proxy for money and throttled
# quality on legitimately complex trips. The agent may now make whatever calls
# a good itinerary needs; cost_ledger.py measures what that actually costs and
# the ceiling below stops the environment when the money runs out. Loop
# breakers that merely stop non-terminating flows live in code
# (graph_policy.MAX_TOOL_PHASES_PER_TURN and friends), not here.

# --- Spend ceiling (the uber control) ---
# Environment-wide measured spend across Azure OpenAI + Google Cloud together,
# in INDIAN RUPEES. Breach -> HTTP 429 carrying resets_at; saved trips and
# preferences are unaffected.
#
# UNITS: INR, never USD. Provider catalogs quote USD and convert exactly once,
# in cost_model.usd_to_inr. Pasting a USD figure here would raise the real
# ceiling by ~88x.
#
# The three windows are NOT multiples of each other on purpose: daily is a
# burst allowance, monthly is the real constraint. At the ~INR 42 average trip
# this model predicts, INR 10,000/month is roughly 13 full testing days, so a
# run of INR 1,000 days exhausts the month well before day 30.
COST_CEILING_INR_DAILY=1000
COST_CEILING_INR_WEEKLY=5000
COST_CEILING_INR_MONTHLY=10000
# Set to 0 to observe and report spend without ever refusing a turn.
COST_CEILING_ENFORCED=1
# Admission decision when the ledger itself cannot be read: an unreadable
# ledger means unknown spend, so hosted environments deny.
COST_CEILING_DENY_ON_LEDGER_ERROR=1
# --- End: Spend ceiling ---

# --- Anti-abuse admission ---
# Sliding per-minute + concurrency admission for /chat. Bounds how fast
# requests arrive, NOT how much they cost -- the ceiling above owns spend.
# Sized so genuine owner testing and a genuine production user never reach
# them; they exist for scripted abuse and viral spikes. Breach -> HTTP 429.
CHAT_USER_REQUESTS_PER_MINUTE=30
CHAT_IP_REQUESTS_PER_MINUTE=90
CHAT_MAX_CONCURRENT_PER_USER=5
CHAT_MAX_CONCURRENT_GLOBAL=12
# --- End: Anti-abuse admission ---

# --- Presentation ---
# How large a photo gallery one page render builds. Visual-density choices,
# not cost controls. PER_REQUEST is named for what it scopes: its predecessor
# said PER_TRIP but reset on every HTTP request, so a trip viewed five times
# signed five times the documented number of photo URLs.
GOOGLE_PLACES_MAX_PHOTOS_PER_PLACE=1
GOOGLE_PLACES_MAX_PHOTOS_PER_REQUEST=40
# --- End: Presentation ---

# === End: Request throttling & usage limits ===

# === Storage (Cosmos DB + secondary durable cache) ===
COSMOS_DEV_BACKEND=azure
COSMOS_ENDPOINT=
COSMOS_DATABASE=tripplanner-prod
COSMOS_USE_MANAGED_IDENTITY=1
COSMOS_EMULATOR=0
SECONDARY_DURABLE_CACHE_ENABLED=0
SECONDARY_DURABLE_CACHE_ENDPOINT=
SECONDARY_DURABLE_CACHE_DATABASE=tripplanner-cache
SECONDARY_DURABLE_CACHE_USE_MANAGED_IDENTITY=0
SECONDARY_DURABLE_CACHE_EMULATOR=0
# === End: Storage ===

# === Logging, audit & app behavior ===
# Master recorder flag (private diagnostics + local trip archive). Restart to apply.
TRIPPLANNER_FLIGHT_RECORDER=0
LOG_LEVEL=INFO
LOG_JSON=1
AUDIT_USER_MESSAGES=0
# Deliberately kept off outside local: log_llm_prompt() also hardcodes an
# environment == "local" check regardless of this flag, but the flag itself
# should still read false-by-default here in case that code-level gate is
# ever weakened.
LOG_FULL_LLM_PROMPTS=0
DECISIONS_UI_ENABLED=1
WEB_ALLOWED_ORIGINS=*
TRIPPLANNER_DEBUG_STORE=0
# === End: Logging, audit & app behavior ===

# === Email / communications ===
AZURE_COMMUNICATION_EMAIL_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_USE_TLS=1
# === End: Email / communications ===
