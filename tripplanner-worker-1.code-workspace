{
  "folders": [
    {
      "name": "Tripplanner Agent 1 - SmallFixes",
      "path": "../tripplanner.worktrees/worker-1"
    }
  ],
  "settings": {
    "window.title": "Agent 1 - SmallFixes | ${activeEditorShort}${separator}${rootName}",
    "chat.editing.autoAcceptDelay": 1,
    "github.copilot.enable": {
      "*": true,
      "plaintext": false
    },
    "files.associations": {
      "**/myprompts.txt": "plaintext"
    },
    "[plaintext]": {
      "editor.inlineSuggest.enabled": false,
      "editor.inlineSuggest.suppressSuggestions": true,
      "editor.quickSuggestions": {
        "comments": "off",
        "strings": "off",
        "other": "off"
      },
      "editor.suggestOnTriggerCharacters": false,
      "editor.wordBasedSuggestions": "off",
      "editor.parameterHints.enabled": false,
      "editor.tabCompletion": "off",
      "editor.acceptSuggestionOnEnter": "off",
      "editor.snippetSuggestions": "none",
      "editor.suggest.showWords": false,
      "editor.suggest.showSnippets": false,
      "editor.suggest.showText": false
    },
    "cSpell.ignorePaths": [
      "docs/reference/archive/myprompts.txt"
    ],
    "workbench.editor.restoreEditors": true,
    "workbench.editor.restoreViewState": true,
    "files.restoreUndoStack": true,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "workbench.colorCustomizations": {
      "activityBar.background": "#115e59",
      "activityBar.foreground": "#ffffff",
      "statusBar.background": "#0f766e",
      "statusBar.foreground": "#ffffff",
      "titleBar.activeBackground": "#115e59",
      "titleBar.activeForeground": "#ffffff"
    }
  }
}