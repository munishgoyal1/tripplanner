# Environment variables — copy to .env and fill in your values
# NEVER commit the actual .env file

# ──────────────────────────────────────────────────────────────
# Azure OpenAI (REQUIRED — the agent's brain)
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ──────────────────────────────────────────────────────────────
# Amadeus Self-Service API (REQUIRED — flights, hotels, activities)
# Sign up free at https://developers.amadeus.com (2000 calls/month)
# ──────────────────────────────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ──────────────────────────────────────────────────────────────
# Google Places API (RECOMMENDED — real ratings & reviews)
# Get key at https://console.cloud.google.com (enable "Places API (New)")
# Free tier: $200/month credit (~10K text searches)
# ──────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────────────────────
# Tavily Web Search (RECOMMENDED — fresh travel content)
# Sign up free at https://tavily.com (1000 searches/month)
# ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
