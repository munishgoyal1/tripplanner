# Environment variables — copy to .env and fill in your values
# NEVER commit the actual .env file

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Google OAuth (download credentials.json from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json

# Google Keep (no official API — uses gkeepapi)
# Option 1: Master token (preferred — get via gkeepapi.Keep().getMasterToken())
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_TOKEN=
# Option 2: App password (generate at myaccount.google.com/apppasswords)
GOOGLE_KEEP_APP_PASSWORD=

# Twilio (SMS / Calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# General
LOG_LEVEL=INFO
