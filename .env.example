# Environment variables — copy to .env and fill in your values
# NEVER commit the actual .env file

# ──────────────────────────────────────────────────────────────
# Azure OpenAI (REQUIRED — the agent's brain)
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ──────────────────────────────────────────────────────────────
# Duffel API (PREFERRED — primary flight provider)
# Free test mode (no credit card): https://app.duffel.com/sign-up
# Test tokens look like duffel_test_xxx, return synthetic offers from Duffel Airways.
# ──────────────────────────────────────────────────────────────
DUFFEL_API_KEY=

# ──────────────────────────────────────────────────────────────
# Amadeus Self-Service API (DEPRECATED — hotels/activities fallback)
# Self-service portal is being decommissioned on July 17, 2026.
# Kept for hotels & activities while we evaluate enterprise-tier replacements.
# Sign up (while available): https://developers.amadeus.com
# ──────────────────────────────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ──────────────────────────────────────────────────────────────
# Google Places API (RECOMMENDED — real ratings & reviews)
# Get key at https://console.cloud.google.com (enable "Places API (New)")
# Free tier: $200/month credit (~10K text searches)
# ──────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────────────────────
# Tavily Web Search (RECOMMENDED — fresh travel content)
# Sign up free at https://tavily.com (1000 searches/month)
# ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────────
# Web session secret + Google OAuth (login screen) — OPTIONAL
# Leave OAUTH_GOOGLE_* empty to keep guest-only mode (no login UI).
# Setup: docs/setup-oauth.md
# Local redirect URI to register in Google Cloud Console:
#   http://localhost:8000/auth/callback/google
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ──────────────────────────────────────────────────────────────
WEB_SESSION_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────────
# Optional email transport for itinerary export
# Choose ONE of these:
#
# 1) Azure Communication Services Email (recommended on Azure)
# AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
# AZURE_COMMUNICATION_EMAIL_SENDER=DoNotReply@YOUR_DOMAIN.azurecomm.net
#
# 2) SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1

LOG_LEVEL=INFO
