# Environment variables — copy to .env and fill in your values
# NEVER commit the actual .env file

# ──────────────────────────────────────────────────────────────
# Azure OpenAI (REQUIRED — the agent's brain)
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

# ──────────────────────────────────────────────────────────────
# Duffel API (PREFERRED — primary flight provider)
# Free test mode (no credit card): https://app.duffel.com/sign-up
# Test tokens look like duffel_test_xxx, return synthetic offers from Duffel Airways.
# ──────────────────────────────────────────────────────────────
DUFFEL_API_KEY=

# ──────────────────────────────────────────────────────────────
# LiteAPI / Nuitee Connect (preferred live hotel and flight availability)
# `auto` prefers LiteAPI when configured and preserves legacy fallback otherwise.
# Keep this key server-side; never expose it to frontend or mobile code.
# ──────────────────────────────────────────────────────────────
LITEAPI_API_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
TRAVEL_HOTEL_PROVIDER=auto
TRAVEL_FLIGHT_PROVIDER=auto

# Static schedule fallbacks used only when persisted/provider timing is absent.
FLIGHT_DURATION_DEFAULT_MIN=90
AIRPORT_DEPARTURE_BUFFER_MIN=120
AIRPORT_ARRIVAL_BUFFER_MIN=45

# Viator sandbox (read-only activity discovery, schedules, and from-prices)
# `auto` prefers Viator when configured and preserves Amadeus fallback otherwise.
VIATOR_API_KEY=
VIATOR_BASE_URL=https://api.sandbox.viator.com/partner
TRAVEL_ACTIVITY_PROVIDER=auto

# ──────────────────────────────────────────────────────────────
# Amadeus Self-Service API (PARKED — no search path uses it)
# Self-service portal is being decommissioned on July 17, 2026. The integration
# is retained only for a possible enterprise-tier contract later. It stays inert
# unless ENABLE_AMADEUS_LEGACY=1 *and* both credentials are set, so adding a key
# alone never reactivates it.
# ──────────────────────────────────────────────────────────────
ENABLE_AMADEUS_LEGACY=0
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ──────────────────────────────────────────────────────────────
# Cache lifetimes (seconds)
# The search cache sits in front of the provider search tools; the fare cache
# backs transport comparisons. Both are real knobs — nothing here is decorative.
# ──────────────────────────────────────────────────────────────
HOTEL_SEARCH_CACHE_TTL_SEC=600
FLIGHT_SEARCH_CACHE_TTL_SEC=600
ACTIVITY_SEARCH_CACHE_TTL_SEC=21600
FLIGHT_CACHE_TTL_SEC=14400
HOTEL_CACHE_TTL_SEC=14400
TRAIN_CACHE_TTL_SEC=43200
COACH_CACHE_TTL_SEC=43200
FERRY_CACHE_TTL_SEC=43200
ACTIVITY_CACHE_TTL_SEC=86400

# ──────────────────────────────────────────────────────────────
# Google Places API (RECOMMENDED — real ratings & reviews)
# Get key at https://console.cloud.google.com (enable "Places API (New)")
# Free tier: $200/month credit (~10K text searches)
# ──────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ──────────────────────────────────────────────────────────────
# OpenRouteService (optional free-tier coordinate routing fallback)
# Standard plan: 2,000 Directions requests/day, 40/minute as of 2026-08.
# Used only for geocoded driving, walking, and cycling routes when Google Routes
# is unavailable; it does not replace Google transit, traffic, or optimization.
# ──────────────────────────────────────────────────────────────
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_ROUTE_TTL_SEC=21600

# GA4 product analytics — optional and production-only. This public measurement
# id is safe to expose; the app still asks for consent before loading GA4.
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# ──────────────────────────────────────────────────────────────
# Tavily Web Search (RECOMMENDED — fresh travel content)
# Sign up free at https://tavily.com (1000 searches/month)
# ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────────
# Web session secret + Google OAuth (login screen) — OPTIONAL
# Leave OAUTH_GOOGLE_* empty to keep guest-only mode (no login UI).
# Setup: docs/development/setup-oauth.md
# Local redirect URI to register in Google Cloud Console:
#   http://localhost:8000/auth/callback/google
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ──────────────────────────────────────────────────────────────
WEB_SESSION_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Chat admission defaults. Completed-request replay checks use separate limits
# so idempotent retries bypass model admission without allowing unbounded reads.
CHAT_USER_REQUESTS_PER_MINUTE=10
CHAT_IP_REQUESTS_PER_MINUTE=30
CHAT_REPLAY_LOOKUPS_PER_MINUTE=60
CHAT_REPLAY_LOOKUPS_PER_IP_PER_MINUTE=180
CHAT_MAX_CONCURRENT_PER_USER=1
CHAT_MAX_CONCURRENT_GLOBAL=4

# Local SPA persistence: "emulator" (default; Docker Cosmos emulator) or
# "azure" (explicit opt-in to the shared account's isolated tripplanner-local database).
COSMOS_DEV_BACKEND=emulator

# ──────────────────────────────────────────────────────────────
# General
# ──────────────────────────────────────────────────────────────
# Optional email transport for itinerary export
# Choose ONE of these:
#
# 1) Azure Communication Services Email (recommended on Azure)
# AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
# AZURE_COMMUNICATION_EMAIL_SENDER=DoNotReply@YOUR_DOMAIN.azurecomm.net
#
# 2) SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1

LOG_LEVEL=INFO
