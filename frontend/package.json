{
  "name": "tripplanner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React SPA for the AI trip planner — talks to the FastAPI backend.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ux-lab": "vite --config labs/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:ux-lab": "tsc -p labs/tsconfig.json && vite build --config labs/vite.config.ts",
    "preview": "vite preview",
    "preview:ux-lab": "vite preview --config labs/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tripplanner/client": "file:../packages/tripplanner-client",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
