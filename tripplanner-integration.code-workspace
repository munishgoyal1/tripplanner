{
  "folders": [
    {
      "name": "Tripplanner MasterAgent",
      "path": "."
    },
    {
      "path": "../tripplanner.worktrees"
    }
  ],
  "settings": {
    "window.title": "MasterAgent - Review & Integration | ${activeEditorShort}${separator}${rootName}",
    "workbench.editor.restoreEditors": true,
    "workbench.editor.restoreViewState": true,
    "files.restoreUndoStack": true,
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "workbench.colorCustomizations": {
      "activityBar.background": "#881337",
      "activityBar.foreground": "#ffffff",
      "statusBar.background": "#9f1239",
      "statusBar.foreground": "#ffffff",
      "titleBar.activeBackground": "#115e59",
      "titleBar.activeForeground": "#ffffff"
    },
    "powershell.cwd": "Tripplanner MasterAgent"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Tripplanner: Sync Sandboxes From Master",
        "type": "shell",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev/sync-sbxs-from-master.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": false,
        "problemMatcher": []
      },
      {
        "label": "Tripplanner: Run Latest Master",
        "type": "shell",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev/run-latest-master.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": []
      }
    ]
  }
}